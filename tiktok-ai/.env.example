# ===== 複製成 .env 後依需要修改 =====

# --- LLM（劇本）---
# 本機免費：Ollama（docker compose 內建），先 docker exec ollama ollama pull qwen2.5:7b
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=ollama
# 雲端範例（二選一，把上面三行換掉）：
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash   LLM_API_KEY=你的Gemini金鑰
# LLM_BASE_URL=https://api.openai.com/v1                                   LLM_MODEL=gpt-4o-mini        LLM_API_KEY=sk-...

# --- 配音（台灣腔，免費免金鑰）---
TTS_BACKEND=edge
TTS_VOICE=zh-TW-HsiaoChenNeural
TTS_RATE=+8%

# --- 圖片：comfyui | pexels | pollinations | placeholder ---
IMAGE_BACKEND=placeholder
COMFYUI_URL=http://comfyui:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
PEXELS_API_KEY=

# --- ① 連結抓文案 ---
DOUYIN_API_URL=http://douyin-api:80
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- ② 聲音克隆 + 對嘴（docker compose --profile voice）---
COSYVOICE_URL=http://cosyvoice:50000
COSYVOICE_MODEL=iic/CosyVoice2-0.5B
COSYVOICE_SAMPLE_RATE=24000
MUSETALK_URL=http://musetalk:8600

# --- 影片 ---
SUBTITLE_FONT=Noto Sans CJK TC
SUBTITLE_FONT_SIZE=64
BGM_PATH=

# --- MoneyPrinterTurbo / AutoClip 會讀的（選填）---
PEXELS_API_KEYS=
GEMINI_API_KEY=
